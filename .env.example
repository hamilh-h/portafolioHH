# Copiá este archivo como .env y completá con tus datos

# Firebase (Consola de Firebase > Configuración del proyecto > Tus apps > App web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# El mail con el que vas a entrar al panel admin
VITE_ADMIN_EMAIL=

# Cloudinary (para imágenes, videos y CV)
VITE_CLOUDINARY_CLOUD=
VITE_CLOUDINARY_PRESET=
